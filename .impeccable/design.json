      "css": ".ds-nudge{display:flex;align-items:center;gap:12px;background:var(--surface,#fff);color:var(--ink,#18203A);border-radius:18px;padding:12px 14px;box-shadow:0 12px 36px rgba(0,0,0,.28);border-left:6px solid var(--bad,#B7263F);font:15px Figtree,system-ui,sans-serif;max-width:520px}.ds-nudge div{flex:1}.ds-nudge b{font:600 1.1rem Fredoka,Nunito,system-ui,sans-serif}.ds-nudge p{margin:2px 0 0;font-size:.9rem;color:var(--muted,#5B6583)}.ds-nudge button{border:0;background:var(--btn,#18203A);color:var(--btn-ink,#fff);border-radius:999px;padding:8px 16px;font-weight:700;cursor:pointer}.ds-nudge button:focus-visible{outline:3px solid var(--focus,#2569C9);outline-offset:2px}"
    }
