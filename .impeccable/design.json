      "css": ".ds-panel{background:var(--surface,#fff);border-radius:24px;box-shadow:0 1px 2px rgba(24,32,58,.06),0 6px 20px rgba(24,32,58,.07);padding:18px;display:flex;flex-direction:column;gap:14px;font:15px/1.45 Figtree,system-ui,sans-serif;color:var(--ink,#18203A)}.ds-panel h2{font:600 1.25rem Fredoka,Nunito,system-ui,sans-serif;margin:0}.ds-chip{display:flex;gap:10px;align-items:center;background:var(--surface-2,#F5F7FB);border-radius:12px;padding:8px 10px;font-size:.92rem}.ds-chip b{color:var(--muted,#5B6583);font-size:.8rem;min-width:40px}"
