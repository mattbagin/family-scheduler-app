      "css": ".ds-tile{position:relative;width:104px;margin:8px;border:2px dashed color-mix(in srgb,var(--pc) 55%,transparent);background:color-mix(in srgb,var(--pc) 7%,#fff);border-radius:18px;padding:12px 6px 10px;display:inline-flex;flex-direction:column;align-items:center;gap:4px;font:600 .85rem Figtree,system-ui,sans-serif;color:#18203A;cursor:pointer;transition:transform .15s}.ds-tile .e{font-size:2rem;line-height:1}.ds-tile:active{transform:scale(.95)}.ds-tile:focus-visible{outline:3px solid var(--focus,#2569C9);outline-offset:2px}.ds-tile.done{border-style:solid;border-color:var(--pc);background:color-mix(in srgb,var(--pc) 20%,#fff)}.ds-tile.done::after{content:\"★\";position:absolute;top:-10px;right:-8px;width:30px;height:30px;border-radius:50%;background:color-mix(in srgb,var(--pc) 85%,#000);color:#fff;display:grid;place-items:center;font-size:17px;animation:ds-stamp .35s cubic-bezier(.3,1.6,.6,1)}@keyframes ds-stamp{from{transform:scale(0) rotate(-40deg)}}"
